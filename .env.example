# ---------------------------------------------------------
# AI tiers: SMART (extract questions in `solve`, once per run),
#           MID   (solve each question group),
#           FAST  (generate stdin for programs, used by `pack`)
#
# Each tier reads {TIER}_PROVIDER, _MODEL, _API_KEY, _BASE_URL, _THINKING.
# _THINKING: off, low, medium, high, xhigh (unset = provider default; agents use low for FAST).
# Unset tiers fall back upwards: FAST -> MID -> SMART.
# Nothing set? The first agent CLI on PATH is used, then Gemini (GEMINI_API_KEY):
#   claude, codex, gemini (gemini-cli), cursor-agent (cursor), opencode, copilot, qwen, amp
# Providers: gemini, openai, claude, codex, gemini-cli, cursor, opencode, copilot, qwen, amp
# ---------------------------------------------------------

GEMINI_API_KEY=your_gemini_api_key

# (Force Gemini instead of agent CLIs; comma-separated models fall back in order):
# SMART_PROVIDER=gemini
# SMART_MODEL=gemini-3.6-flash,gemini-3.5-flash
# MID_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
# FAST_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# (Example: Groq for FAST):
# FAST_PROVIDER=openai
# FAST_MODEL=llama3-70b-8192
# FAST_BASE_URL=https://api.groq.com/openai/v1
# FAST_API_KEY=your_groq_api_key

# --- Server ---
# Web users bring their own Gemini key. The admin password (or `serve --no-key`)
# makes the server use the config above instead, agent CLIs included.
ADMIN_PASSWORD=your_secret_password
# SAVECODEX_NO_KEY=true

# --- CLI defaults ---
SAVECODEX_STYLE=macos
SAVECODEX_DOC_TEXT="\nSOMETHING - ENROLLNO - {}\n"
SAVECODEX_OUTPUT="ETCETC_{}.docx"
