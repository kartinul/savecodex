# ---------------------------------------------------------
# Provider selection: "gemini" or "openai_compatible"
# ---------------------------------------------------------
# If using Gemini for any of the below, you only need this once:
GEMINI_API_KEY=your_gemini_api_key

# Set an admin password to bypass entering the API key on the frontend
ADMIN_PASSWORD=your_secret_password

# --- CLI Default Settings ---
# You can set default values for `savecodex pack` arguments here
SAVECODEX_STYLE=macos
SAVECODEX_DOC_TEXT="\nSOMETHING - ENROLLNO - {}\n"
SAVECODEX_OUTPUT="ETCETC_{}.docx"

# --- Code Generation Settings ---
CODE_PROVIDER=gemini
# You can provide multiple Gemini models separated by commas (e.g. model1,model2) 
# and it will automatically fallback to the next one if a request fails.
CODE_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash

# (Example if you wanted Groq instead for code gen):
# CODE_PROVIDER=openai_compatible
# CODE_MODEL=llama3-70b-8192
# CODE_BASE_URL=https://api.groq.com/openai/v1
# CODE_API_KEY=your_groq_api_key

# --- Input Generation Settings ---
INPUT_PROVIDER=gemini
# Fallback mechanism is supported for Gemini models here too
INPUT_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# (Example if you wanted local Ollama instead for input gen):
# INPUT_PROVIDER=openai_compatible
# INPUT_MODEL=llama3
# INPUT_BASE_URL=http://localhost:11434/v1
# INPUT_API_KEY=ollama
