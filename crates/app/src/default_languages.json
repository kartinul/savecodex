{
  "py": {
    "run": [
      "python3",
      "{file}"
    ],
    "windows": {
      "run": [
        "python",
        "{file}"
      ]
    },
    "stdin": [
      "input(",
      "sys.stdin",
      "fileinput"
    ]
  },
  "rs": {
    "build": [
      "rustc",
      "{file}",
      "-o",
      "{dir}/{file_stem}"
    ],
    "run": [
      "{dir}/{file_stem}"
    ],
    "windows": {
      "build": [
        "rustc",
        "{file}",
        "-o",
        "{dir}/{file_stem}.exe"
      ],
      "run": [
        "{dir}/{file_stem}.exe"
      ]
    },
    "stdin": [
      "stdin()"
    ]
  },
  "cpp": {
    "build": [
      "g++",
      "{file}",
      "-o",
      "{dir}/{file_stem}"
    ],
    "run": [
      "{dir}/{file_stem}"
    ],
    "windows": {
      "build": [
        "g++",
        "{file}",
        "-o",
        "{dir}/{file_stem}.exe"
      ],
      "run": [
        "{dir}/{file_stem}.exe"
      ]
    },
    "stdin": [
      "cin",
      "scanf",
      "getchar",
      "fgets",
      "gets("
    ]
  },
  "c": {
    "build": [
      "gcc",
      "{file}",
      "-o",
      "{dir}/{file_stem}"
    ],
    "run": [
      "{dir}/{file_stem}"
    ],
    "windows": {
      "build": [
        "gcc",
        "{file}",
        "-o",
        "{dir}/{file_stem}.exe"
      ],
      "run": [
        "{dir}/{file_stem}.exe"
      ]
    },
    "stdin": [
      "scanf",
      "getchar",
      "fgets",
      "gets(",
      "getc(stdin",
      "read(0"
    ]
  },
  "js": {
    "run": [
      "node",
      "{file}"
    ],
    "stdin": [
      "readline",
      "process.stdin",
      "prompt(",
      "/dev/stdin"
    ]
  },
  "java": {
    "run": [
      "java",
      "{file}"
    ],
    "stdin": [
      "System.in",
      "Scanner",
      "Console"
    ]
  },
  "sh": {
    "run": [
      "bash",
      "{file}"
    ],
    "stdin": [
      "read ",
      "read\t",
      "$(cat",
      "/dev/stdin"
    ]
  }
}