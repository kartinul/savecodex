{
  "py": {
    "run": [
      "python3",
      "{file}"
    ],
    "windows": {
      "run": [
        "python",
        "{file}"
      ]
    },
    "stdin": [
      "input(",
      "sys.stdin",
      "fileinput"
    ]
  },
  "rs": {
    "build": [
      "rustc",
      "{file}",
      "-o",
      "{dir}/{file_stem}"
    ],
    "run": [
      "{dir}/{file_stem}"
    ],
    "windows": {
      "build": [
        "rustc",
        "{file}",
        "-o",
        "{dir}/{file_stem}.exe"
      ],
      "run": [
        "{dir}/{file_stem}.exe"
      ]
    },
    "stdin": [
      "stdin()"
    ]
  },
  "cpp": {
    "build": [
      "g++",
      "{file}",
      "-o",
      "{dir}/{file_stem}"
    ],
    "run": [
      "{dir}/{file_stem}"
    ],
    "windows": {
      "build": [
        "g++",
        "{file}",
        "-o",
        "{dir}/{file_stem}.exe"
      ],
      "run": [
        "{dir}/{file_stem}.exe"
      ]
    },
    "stdin": [
      "cin",
      "scanf",
      "getchar",
      "fgets",
      "gets("
    ]
  },
  "c": {
    "build": [
      "gcc",
      "{file}",
      "-o",
      "{dir}/{file_stem}"
    ],
    "run": [
      "{dir}/{file_stem}"
    ],
    "windows": {
      "build": [
        "gcc",
        "{file}",
        "-o",
        "{dir}/{file_stem}.exe"
      ],
      "run": [
        "{dir}/{file_stem}.exe"
      ]
    },
    "stdin": [
      "scanf",
      "getchar",
      "fgets",
      "gets(",
      "getc(stdin",
      "read(0"
    ]
  },
  "js": {
    "run": [
      "node",
      "{file}"
    ],
    "stdin": [
      "readline",
      "process.stdin",
      "prompt(",
      "/dev/stdin"
    ]
  },
  "java": {
    "run": [
      "java",
      "{file}"
    ],
    "stdin": [
      "System.in",
      "Scanner",
      "Console"
    ]
  },
  "sh": {
    "run": [
      "bash",
      "{file}"
    ],
    "stdin": [
      "read ",
      "read\t",
      "$(cat",
      "/dev/stdin"
    ]
  },
  "mysql": {
    "session": true,
    "reset": [
      "mysql",
      "-e",
      "DROP DATABASE IF EXISTS lab{n}; CREATE DATABASE lab{n}"
    ],
    "run": [
      "mysql",
      "lab{n}"
    ],
    "prompts": [
      "mysql> ",
      "    -> ",
      "    '> ",
      "    \"> ",
      "    `> ",
      "   /*> "
    ]
  },
  "shell": {
    "session": true,
    "run": [
      "env",
      "PS1=$ ",
      "PS2=> ",
      "HISTFILE=/dev/null",
      "BASH_SILENCE_DEPRECATION_WARNING=1",
      "bash",
      "--norc",
      "--noprofile",
      "+H",
      "-i"
    ],
    "prompts": [
      "$ ",
      "> "
    ]
  },
  "dot": {
    "image": true,
    "run": [
      "dot",
      "-Tpng",
      "-Gdpi=150",
      "{file}",
      "-o",
      "{dir}/{file_stem}.png"
    ],
    "hide_code": true
  },
  "html": {
    "image": true,
    "run": [
      "chromium",
      "--headless",
      "--use-mock-keychain",
      "--disable-gpu",
      "--hide-scrollbars",
      "--window-size=1280,800",
      "--screenshot={dir}/{file_stem}.png",
      "{file}"
    ],
    "macos": {
      "run": [
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "--headless",
        "--use-mock-keychain",
        "--disable-gpu",
        "--hide-scrollbars",
        "--window-size=1280,800",
        "--screenshot={dir}/{file_stem}.png",
        "{file}"
      ]
    },
    "windows": {
      "run": [
        "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "--headless",
        "--use-mock-keychain",
        "--disable-gpu",
        "--hide-scrollbars",
        "--window-size=1280,800",
        "--screenshot={dir}/{file_stem}.png",
        "{file}"
      ]
    }
  },
  "plot": {
    "image": true,
    "run": [
      "env",
      "MPLBACKEND=Agg",
      "python3",
      "{file}"
    ]
  }
}
